# Place limit definitions in nginx's http context. Adapt hostname and TLS paths.
limit_req_zone $binary_remote_addr zone=colors_rate:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=colors_conn:10m;
server {
    listen 443 ssl;
    server_name colors.example.com;
    ssl_certificate /etc/letsencrypt/live/colors.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/colors.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 3m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_req zone=colors_rate burst=60 nodelay;
    limit_req_status 429;
    limit_conn colors_conn 16;
    location = /applications/games/colors/open/command.do {
        proxy_pass http://127.0.0.1:8080;
        proxy_request_buffering on;
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
        proxy_cache off;
        access_log off;
    }
    location = /colors.php {
        proxy_pass http://127.0.0.1:8080;
        proxy_request_buffering on;
        proxy_read_timeout 120s;
        proxy_cache off;
        access_log off;
    }
    location = /health { proxy_pass http://127.0.0.1:8080; }
    location / { return 404; }
}
